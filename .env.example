# AccountingSim settings
# Local computer: copy this file to .env.local   ·   VPS (Docker): copy it to .env
# Never commit the real file (it's in .gitignore).

# ---- Website ----
# The public address of the app (used for secure cookies). Locally: http://localhost:3000
APP_URL=https://accsim.example.com
# Domain for Caddy's automatic HTTPS certificate (VPS only, no https://)
DOMAIN=accsim.example.com
# Long random text that protects sign-in codes and sessions. Make one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-characters

# ---- Who can sign in ----
# Doctor accounts (comma separated). Anyone else must use the student email domain.
TEACHER_EMAILS=aliya.albalushi@gutech.edu.om,asnssrr@gmail.com,dark99mam@gmail.com,rawahi.s96@gmail.com
STUDENT_EMAIL_DOMAIN=student.gutech.edu.om

# ---- Email (Resend: https://resend.com) ----
# Leave RESEND_API_KEY empty on your own computer: sign-in codes are then printed in the server log.
# On the VPS: verify your domain in Resend first, otherwise Resend only delivers to your own address.
RESEND_API_KEY=
MAIL_FROM=AccountingSim <noreply@accsim.example.com>

# ---- AI (DeepSeek: https://platform.deepseek.com) ----
DEEPSEEK_API_KEY=
# Model name exactly as DeepSeek lists it
DEEPSEEK_MODEL=deepseek-chat
# true only if that model accepts images (lets the doctor upload screenshots as samples)
AI_VISION=false

# ---- Database ----
# VPS (Docker): set by docker-compose, leave as is.
# Local computer: leave DATABASE_URL empty to use the built-in database stored in ./data
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=
